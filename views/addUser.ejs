<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Add User</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar bg-body-tertiary mb-4">
        <div class="container"><span class="navbar-brand mb-0 h1">User Management</span></div>
    </nav>
    <main class="container" style="max-width: 650px">
        <h1 class="h3 mb-3">Add New User</h1>
        <% if (error) { %>
            <div class="alert alert-danger" role="alert"><%= error %></div>
        <% } %>
        <form action="/users" method="post" class="border rounded p-4 bg-light">
            <div class="mb-3">
                <label for="fname" class="form-label">First Name</label>
                <input id="fname" name="fname" class="form-control" type="text" maxlength="50" value="<%= values.fname || '' %>" required>
            </div>
            <div class="mb-3">
                <label for="lname" class="form-label">Last Name</label>
                <input id="lname" name="lname" class="form-control" type="text" maxlength="50" value="<%= values.lname || '' %>" required>
            </div>
            <div class="mb-3">
                <label for="username" class="form-label">User Name</label>
                <input id="username" name="username" class="form-control" type="text" maxlength="50" value="<%= values.username || '' %>" required>
            </div>
            <div class="mb-3">
                <label for="passwd" class="form-label">Password</label>
                <input id="passwd" name="passwd" class="form-control" type="password" maxlength="255" required>
            </div>
            <button class="btn btn-primary" type="submit">Add User</button>
            <a class="btn btn-outline-secondary ms-2" href="/">Cancel</a>
        </form>
    </main>
</body>
</html>
